# Force LF for shell scripts, Dockerfiles, Nginx configs, YAML, and JS
*.sh          text eol=lf
Dockerfile    text eol=lf
Dockerfile.*  text eol=lf
*.conf        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.js          text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.json        text eol=lf
*.jsx         text eol=lf
*.css         text eol=lf
*.html        text eol=lf