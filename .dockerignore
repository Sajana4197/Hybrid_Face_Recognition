# Exclude everything by default
*
!.dockerignore
!Dockerfile
!docker-compose.yaml
!requirements.txt

# Include only the Python code needed by the services
!software_builds/field_client/backend/**
!software_builds/admin_client/backend/**
!fusion/**
!preprocess/**
!neuralhash/**
!hdic/**

# Python build artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Large/irrelevant artifacts (keep these excluded everywhere)
**/*.pt
**/*.pth
**/*.h5
**/*.ckpt
**/*.onnx
**/*.npy
**/*.npz
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.7z
**/*.rar
**/*.iso
**/*.mp4
**/*.mov
**/*.avi
**/*.mkv
**/*.webm
**/*.wav

# Local envs, caches, datasets, logs, uploads
.venv/
venv/
env/
data/
datasets/
db/
logs/
outputs/
runs/
media/
uploads/
software_builds/**/verifications/
software_builds/**/uploads/

# VCS/editor files
.git
.git/
**/.git
.vscode/
.DS_Store
Thumbs.db